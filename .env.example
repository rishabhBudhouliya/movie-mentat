# Copy to .env.local. Defaults point at the local Docker Postgres (compose.yaml).
# In deployment, DATABASE_URL is Neon's pooled URL and DIRECT_URL its direct URL.
DATABASE_URL=postgresql://mentat:mentat@localhost:5433/movie_mentat
DIRECT_URL=postgresql://mentat:mentat@localhost:5433/movie_mentat

APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
TMDB_READ_TOKEN=
